{
 "title": "Notifications",
 "subtitle": "Choose what the app tells you about",
 "intro": "Turn on only what you want. Your choices stay on this phone. Block alerts follow the address saved on Home.",
 "days": 14,
 "max": 60,
 "checkMinutes": 15,
 "groups": [
  {
   "title": "Your block",
   "topics": [
    {
     "id": "asp",
     "title": "Alternate side parking",
     "sub": "The night before street cleaning on your block, and a heads-up when it is suspended.",
     "alertTitle": "Move your car: street cleaning tomorrow",
     "alertBody": "{sched} on {@block}.",
     "source": "block-asp",
     "skip": {
      "file": "civic/cal/calendar-city.json",
      "at": "events",
      "where": {
       "k": "altside"
      }
     },
     "when": [
      {
       "daysBefore": 1,
       "at": "20:00"
      }
     ],
     "suspended": {
      "alertTitle": "ASP suspended tomorrow",
      "alertBody": "No need to move your car for street cleaning on {@block} tomorrow, {d|date}.",
      "when": [
       {
        "daysBefore": 1,
        "at": "20:00"
       }
      ]
     }
    },
    {
     "id": "dsny",
     "title": "Trash, recycling and compost",
     "sub": "The night before pickup on your block. Skipped on holidays with no collection.",
     "alertTitle": "{kinds} tomorrow",
     "alertBody": "Put it out tonight for pickup on {@block}.",
     "source": "block-dsny",
     "when": [
      {
       "daysBefore": 1,
       "at": "19:00"
      }
     ]
    }
   ]
  },
  {
   "title": "Meetings",
   "topics": [
    {
     "id": "cb6-meetings",
     "apps": [
      "cb6"
     ],
     "default": false,
     "title": "CB6 meetings",
     "sub": "The full board and every committee, the day before and an hour before.",
     "alertTitle": "{l}",
     "alertBody": "{d|date} at {t|time}. {loc}",
     "file": "civic/cal/calendar-city.json",
     "at": "events",
     "where": {
      "cd": "306"
     },
     "when": [
      {
       "daysBefore": 1,
       "at": "10:00"
      },
      {
       "minutesBefore": 60
      }
     ]
    },
    {
     "id": "my-board",
     "title": "My community board",
     "sub": "Meetings of the board for the address saved on Home.",
     "alertTitle": "{l}",
     "alertBody": "{d|date} at {t|time}. {loc}",
     "file": "civic/cal/calendar-city.json",
     "at": "events",
     "where": {
      "cd": "@board"
     },
     "when": [
      {
       "daysBefore": 1,
       "at": "10:00"
      },
      {
       "minutesBefore": 60
      }
     ]
    },
    {
     "id": "boards",
     "apps": [
      "bk",
      "beyond"
     ],
     "title": "Other community boards",
     "sub": "Pick any boards in the city.",
     "alertTitle": "{l}",
     "alertBody": "{d|date} at {t|time}. {loc}",
     "file": "civic/cal/calendar-city.json",
     "at": "events",
     "where": {
      "cd": "@picks"
     },
     "pick": {
      "title": "Community boards",
      "prompt": "Choose boards",
      "file": "civic/boards.json",
      "value": "borocd",
      "label": "name",
      "sub": "borough"
     },
     "when": [
      {
       "daysBefore": 1,
       "at": "10:00"
      }
     ]
    },
    {
     "id": "council",
     "title": "City Council hearings",
     "sub": "Council meetings and hearings, the day before.",
     "alertTitle": "{l}",
     "alertBody": "{d|date} at {t|time}. {loc}",
     "file": "civic/cal/calendar-city.json",
     "at": "events",
     "where": {
      "ty": "new-york-city-council"
     },
     "when": [
      {
       "daysBefore": 1,
       "at": "10:00"
      }
     ]
    },
    {
     "id": "hearings",
     "title": "Public hearings",
     "sub": "City agency public hearings, the day before.",
     "alertTitle": "{l}",
     "alertBody": "{d|date} at {t|time}. {loc}",
     "file": "civic/cal/calendar-city.json",
     "at": "events",
     "where": {
      "ty": "public-hearing"
     },
     "when": [
      {
       "daysBefore": 1,
       "at": "10:00"
      }
     ]
    }
   ]
  },
  {
   "title": "Organizations",
   "topics": [
    {
     "id": "orgs",
     "title": "Events from organizations I follow",
     "sub": "Pick parks, libraries, venues, groups and officials. You hear about their events the day before.",
     "alertTitle": "{l}",
     "alertBody": "{d|date} at {t|time}. {loc}",
     "file": "civic/cal/calendar-city.json",
     "at": "events",
     "where": {
      "ty": "@picks"
     },
     "pick": {
      "title": "Organizations",
      "prompt": "Choose organizations",
      "file": "civic/cal/calendar-city.json",
      "at": "types",
      "value": "key",
      "label": "name"
     },
     "when": [
      {
       "daysBefore": 1,
       "at": "10:00"
      }
     ]
    }
   ]
  },
  {
   "title": "Subway and buses",
   "topics": [
    {
     "id": "subway",
     "title": "Subway lines",
     "sub": "Delays, suspensions and service changes on the lines you pick, as they come up.",
     "alertTitle": "{routes} train: {type}",
     "alertBody": "{title}",
     "source": "alerts",
     "file": "civic/alerts/transit.json",
     "at": "alerts",
     "rowId": "id",
     "where": {
      "kind": "subway",
      "routes": "@picks",
      "status": "now"
     },
     "pick": {
      "title": "Subway lines",
      "prompt": "Choose lines",
      "file": "civic/alerts/routes.json",
      "at": "subway"
     }
    },
    {
     "id": "subway-planned",
     "title": "Planned work on my lines",
     "sub": "Weekend and overnight work on the subway lines you picked above, when it starts.",
     "alertTitle": "{routes} train: {type}",
     "alertBody": "{title}",
     "source": "alerts",
     "file": "civic/alerts/transit.json",
     "at": "alerts",
     "rowId": "id",
     "where": {
      "kind": "subway",
      "routes": "@picks:subway",
      "status": "planned"
     }
    },
    {
     "id": "bus",
     "title": "Bus routes",
     "sub": "Detours, delays and changes on the routes you pick, as they come up.",
     "alertTitle": "{routes}: {type}",
     "alertBody": "{title}",
     "source": "alerts",
     "file": "civic/alerts/transit.json",
     "at": "alerts",
     "rowId": "id",
     "where": {
      "kind": "bus",
      "routes": "@picks"
     },
     "pick": {
      "title": "Bus routes",
      "prompt": "Choose routes",
      "file": "civic/alerts/routes.json",
      "at": "bus"
     }
    }
   ]
  }
 ]
}